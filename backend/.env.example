# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://mashmagic-lms.vercel.app

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
